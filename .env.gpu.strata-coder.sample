# =================================================================
# STRATA - QWEN3.8-FLASH-NEXT CODER (IQ1_M) - CUDA MODE
# =================================================================
# WHEN TO USE: coding agents on a 32 GB RAM / 12 GB VRAM PC. The Coder keeps
# 256 of the 512 experts per layer (chosen on code, tool and agentic data),
# so it is weaker outside code and in non-English languages.
#
#   download   ~58 GB (first start only, into STRATA_DATA_DIR)
#   experts    ~23 GB: 3.75 GB cached on the GPU, the other 19.7 GB in RAM
#   KV         128K context, q4_0, kept in VRAM (WSL cannot stream it to RAM)
#
# Launch with: ./scripts/docker/launch-server.sh .env.gpu.strata-coder

COMPOSE_FILE=docker/docker-compose-gpu-strata-coder.yml

# Strata commit the image is built from. Bump it on purpose, never track main.
STRATA_REF=6f32ec070f23ced9f50e704d854d775da52591ab
# CUDA arch of the card the engine is compiled for (89 = RTX 40).
STRATA_CUDA_ARCH=89

STRATA_FAMILY=coder
STRATA_MODEL=IQ1_M
STRATA_CONTEXT_SIZE=131072
STRATA_KV=q4_0

STRATA_HOST=127.0.0.1
STRATA_PORT=12345
STRATA_API_KEY=""
# Host names clients use to reach this server, e.g. "myhost,myhost.local".
# Without them Strata answers only to localhost and IP addresses.
STRATA_ALLOWED_HOSTS=""

STRATA_DATA_DIR=""
