--- a/docker-entrypoint.sh	2026-10-04 22:29:43
+++ b/docker-entrypoint.sh	2026-10-05 09:28:09
@@ -52,6 +52,36 @@
   [ -e "/opt/strata/strata-$tag.json" ] || ln -s "$cfg" "/opt/strata/strata-$tag.json"
 fi
 
+# Local patch: settings the upstream entry point has no env var for, written
+# into the saved config and into the live copy setup reads:
+#   STRATA_RESIDENT_BUDGET_GIB      -> args --resident-budget-gib N
+#   STRATA_REASONING_BUDGET_TOKENS  -> "reasoning_budget_tokens": N
+#   STRATA_FIT_MAX_TOKENS=1         -> "fit_max_tokens": true
+#   STRATA_SAMPLING (JSON object)   -> "sampling": {...}
+.venv/bin/python - "$cfg" "/opt/strata/strata-$tag.json" <<'PY'
+import json, os, sys
+cfg, live = sys.argv[1:3]
+c = json.load(open(cfg))
+gib = os.environ.get("STRATA_RESIDENT_BUDGET_GIB", "")
+if gib:
+    a = c["args"]
+    if "--resident-budget-gib" in a:
+        a[a.index("--resident-budget-gib") + 1] = gib
+    else:
+        a += ["--resident-budget-gib", gib]
+think = os.environ.get("STRATA_REASONING_BUDGET_TOKENS", "")
+if think:
+    c["reasoning_budget_tokens"] = int(think)
+if os.environ.get("STRATA_FIT_MAX_TOKENS", "") == "1":
+    c["fit_max_tokens"] = True
+sampling = os.environ.get("STRATA_SAMPLING", "")
+if sampling:
+    c["sampling"] = json.loads(sampling)
+json.dump(c, open(cfg, "w"), indent=1)
+if os.path.exists(live) and not os.path.islink(live):
+    json.dump(c, open(live, "w"), indent=1)
+PY
+
